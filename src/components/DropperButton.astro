---
interface Props {
  dropperHelper?: string;
  dropperError?: string;
}

const {
  dropperHelper = 'Click the lens to select any pixel on screen',
  dropperError = 'Screen dropper is supported in Chrome, Edge, and Opera. On other browsers, use the image uploader below!'
} = Astro.props;
---
<div class="flex flex-col items-center justify-center py-4 w-full">
  <button
    id="dropper-button"
    type="button"
    class="group relative flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-tr from-neutral-900 via-neutral-800 to-neutral-900 text-white shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95 transition-all duration-300 ring-4 ring-neutral-200/80 dark:ring-neutral-700/80 hover:ring-neutral-400 dark:hover:ring-neutral-500 cursor-pointer focus:outline-none focus:ring-neutral-900 dark:focus:ring-white"
    title="Click to pick any color from your screen"
    aria-label="Pick color from your screen"
  >
    <!-- Background pulse indicator -->
    <span class="absolute inset-0 rounded-full bg-indigo-500/20 group-hover:bg-indigo-500/40 blur-md transition-all"></span>
    
    <!-- SVG Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-10 h-10 text-white group-hover:rotate-12 transition-transform duration-300 z-10"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m2 22 1-1h3l9-9" />
      <path d="M3 21v-3l9-9" />
      <path d="m15 6 3-3a2.12 2.12 0 0 1 3 3l-3 3" />
      <path d="m13 8 3 3" />
    </svg>
  </button>
  
  <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-3 font-medium text-center">
    {dropperHelper}
  </p>

  <div id="dropper-error" class="hidden text-xs text-amber-600 dark:text-amber-300 mt-2 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/80 px-3 py-1.5 rounded-md text-center max-w-xs">
    {dropperError}
  </div>
</div>

<script>
  const dropperBtn = document.getElementById('dropper-button');
  const dropperError = document.getElementById('dropper-error');

  if (dropperBtn) {
    dropperBtn.addEventListener('click', async () => {
      if ('EyeDropper' in window) {
        try {
          // @ts-ignore - EyeDropper is supported in chromium browsers
          const eyeDropper = new window.EyeDropper();
          const result = await eyeDropper.open();
          if (result && result.sRGBHex) {
            const hexColor = result.sRGBHex.toUpperCase();
            
            // Dispatch event for color picked
            window.dispatchEvent(new CustomEvent('colorpicked', {
              detail: { color: hexColor, source: 'dropper' }
            }));

            // Scroll to color swatch section
            const resultSection = document.getElementById('color-result-section');
            if (resultSection) {
              resultSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        } catch (err) {
          console.log('EyeDropper closed or canceled by user', err);
        }
      } else {
        if (dropperError) {
          dropperError.classList.remove('hidden');
        }
      }
    });
  }
</script>
