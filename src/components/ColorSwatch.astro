---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'en' } = Astro.props;
const t = useTranslations(currentLang);
---
<div id="color-result-section" class="w-full max-w-4xl mx-auto my-8 scroll-mt-24">
  <div class="card rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
    
    <!-- Top label / status -->
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-border-subtle">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-text-primary inline-block"></span>
        <h3 class="text-lg font-bold text-text-primary tracking-tight">
          {t('extractedTitle')}
        </h3>
      </div>
      <span class="text-xs font-mono text-text-muted uppercase tracking-widest bg-surface-secondary px-3 py-1 rounded-full">
        {t('swatchStatus')}
      </span>
    </div>

    <!-- Main Grid: Swatch Box + Details -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      
      <!-- Swatch Box Column -->
      <div class="md:col-span-4 flex flex-col items-center justify-center">
        <div
          id="color-preview-box"
          class="w-36 h-36 sm:w-44 sm:h-44 rounded-2xl shadow-inner border-4 border-white ring-1 ring-border transition-all duration-300 flex flex-col items-center justify-center relative group"
          style="background-color: #7928CA;"
        >
          <span id="preview-hex-display" class="font-mono text-xl sm:text-2xl font-bold text-white drop-shadow-md select-all">
            #7928CA
          </span>
          <span class="text-[11px] font-medium text-white/80 uppercase tracking-wider mt-1 drop-shadow-sm">
            {t('activeColor')}
          </span>
        </div>
      </div>

      <!-- Color Codes Column -->
      <div class="md:col-span-8 space-y-4">
        
        <!-- HEX -->
        <div class="flex items-center justify-between bg-surface-secondary p-3 sm:p-4 rounded-xl border border-border-subtle">
          <div class="flex items-center space-x-3">
            <span class="text-xs font-bold font-mono text-text-muted uppercase w-10">HEX</span>
            <span id="value-hex" class="text-base sm:text-lg font-mono font-bold text-text-primary">#7928CA</span>
          </div>
          <button
            type="button"
            data-copy="#value-hex"
            data-copied-text={t('copied')}
            class="copy-btn px-3 py-1.5 btn-secondary hover:bg-surface-tertiary border border-border rounded-lg text-xs font-medium transition-all shadow-sm flex items-center space-x-1.5 cursor-pointer active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>{t('copyHex')}</span>
          </button>
        </div>

        <!-- RGB -->
        <div class="flex items-center justify-between bg-surface-secondary p-3 sm:p-4 rounded-xl border border-border-subtle">
          <div class="flex items-center space-x-3">
            <span class="text-xs font-bold font-mono text-text-muted uppercase w-10">RGB</span>
            <span id="value-rgb" class="text-base sm:text-lg font-mono font-bold text-text-primary">rgb(121, 40, 202)</span>
          </div>
          <button
            type="button"
            data-copy="#value-rgb"
            data-copied-text={t('copied')}
            class="copy-btn px-3 py-1.5 btn-secondary hover:bg-surface-tertiary border border-border rounded-lg text-xs font-medium transition-all shadow-sm flex items-center space-x-1.5 cursor-pointer active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>{t('copyRgb')}</span>
          </button>
        </div>

        <!-- HSL -->
        <div class="flex items-center justify-between bg-surface-secondary p-3 sm:p-4 rounded-xl border border-border-subtle">
          <div class="flex items-center space-x-3">
            <span class="text-xs font-bold font-mono text-text-muted uppercase w-10">HSL</span>
            <span id="value-hsl" class="text-base sm:text-lg font-mono font-bold text-text-primary">hsl(270, 67%, 47%)</span>
          </div>
          <button
            type="button"
            data-copy="#value-hsl"
            data-copied-text={t('copied')}
            class="copy-btn px-3 py-1.5 btn-secondary hover:bg-surface-tertiary border border-border rounded-lg text-xs font-medium transition-all shadow-sm flex items-center space-x-1.5 cursor-pointer active:scale-95"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span>{t('copyHsl')}</span>
          </button>
        </div>

      </div>
    </div>

    <!-- Action Bar: Download Option -->
    <div class="mt-6 pt-4 border-t border-border-subtle flex flex-wrap items-center justify-between gap-3">
      <p class="text-xs text-text-muted font-medium">
        {t('copyNote')}
      </p>

      <div class="flex items-center space-x-3">
        <!-- Download Palette Card PNG -->
        <button
          type="button"
          id="download-color-card"
          class="px-4 py-2 btn-primary text-text-on-accent hover:bg-surface-tertiary rounded-xl text-xs font-semibold shadow-md hover:shadow-lg transition-all flex items-center space-x-2 cursor-pointer active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>{t('downloadPng')}</span>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  const previewBox = document.getElementById('color-preview-box');
  const hexDisplay = document.getElementById('preview-hex-display');
  const valueHex = document.getElementById('value-hex');
  const valueRgb = document.getElementById('value-rgb');
  const valueHsl = document.getElementById('value-hsl');
  const downloadBtn = document.getElementById('download-color-card');

  let currentHex = '#7928CA';

  function hexToRgb(hex: string) {
    hex = hex.replace('#', '');
    if (hex.length === 3) {
      hex = hex.split('').map(c => c + c).join('');
    }
    const num = parseInt(hex, 16);
    return {
      r: (num >> 16) & 255,
      g: (num >> 8) & 255,
      b: num & 255
    };
  }

  function rgbToHsl(r: number, g: number, b: number) {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;

    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return {
      h: Math.round(h * 360),
      s: Math.round(s * 100),
      l: Math.round(l * 100)
    };
  }

  function updateColorResult(hex: string) {
    hex = hex.toUpperCase();
    currentHex = hex;
    const { r, g, b } = hexToRgb(hex);
    const { h, s, l } = rgbToHsl(r, g, b);

    const rgbStr = `rgb(${r}, ${g}, ${b})`;
    const hslStr = `hsl(${h}, ${s}%, ${l}%)`;

    if (previewBox) previewBox.style.backgroundColor = hex;
    if (hexDisplay) hexDisplay.textContent = hex;
    if (valueHex) valueHex.textContent = hex;
    if (valueRgb) valueRgb.textContent = rgbStr;
    if (valueHsl) valueHsl.textContent = hslStr;

    if (hexDisplay) {
      const brightness = (r * 299 + g * 587 + b * 114) / 1000;
      if (brightness > 160) {
        hexDisplay.style.color = '#171717';
      } else {
        hexDisplay.style.color = '#FFFFFF';
      }
    }
  }

  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const targetSelector = btn.getAttribute('data-copy');
      const copiedText = btn.getAttribute('data-copied-text') || 'Copied!';
      if (!targetSelector) return;
      const targetEl = document.querySelector(targetSelector);
      if (!targetEl || !targetEl.textContent) return;

      navigator.clipboard.writeText(targetEl.textContent.trim()).then(() => {
        const span = btn.querySelector('span');
        if (span) {
          const origText = span.textContent;
          span.textContent = copiedText;
          btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
          setTimeout(() => {
            span.textContent = origText;
            btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
          }, 1500);
        }
      });
    });
  });

  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      const cardCanvas = document.createElement('canvas');
      cardCanvas.width = 800;
      cardCanvas.height = 450;
      const ctx = cardCanvas.getContext('2d');
      if (!ctx) return;

      // Use theme-aware colors for the downloaded card
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--surface').trim() || '#fafafa';
      ctx.fillRect(0, 0, 800, 450);

      ctx.fillStyle = currentHex;
      ctx.beginPath();
      ctx.roundRect(40, 40, 320, 370, 24);
      ctx.fill();

      const textPrimary = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#171717';
      const textSecondary = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim() || '#666666';
      const textMuted = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#a1a1a1';

      ctx.fillStyle = textPrimary;
      ctx.font = 'bold 36px sans-serif';
      ctx.fillText('Color Spec Card', 400, 90);

      ctx.fillStyle = textSecondary;
      ctx.font = '18px monospace';
      ctx.fillText('HEX:', 400, 160);
      ctx.fillStyle = textPrimary;
      ctx.font = 'bold 24px monospace';
      ctx.fillText(valueHex?.textContent || currentHex, 480, 160);

      ctx.fillStyle = textSecondary;
      ctx.font = '18px monospace';
      ctx.fillText('RGB:', 400, 230);
      ctx.fillStyle = textPrimary;
      ctx.font = 'bold 24px monospace';
      ctx.fillText(valueRgb?.textContent || '', 480, 230);

      ctx.fillStyle = textSecondary;
      ctx.font = '18px monospace';
      ctx.fillText('HSL:', 400, 300);
      ctx.fillStyle = textPrimary;
      ctx.font = 'bold 24px monospace';
      ctx.fillText(valueHsl?.textContent || '', 480, 300);

      ctx.fillStyle = textMuted;
      ctx.font = '14px sans-serif';
      ctx.fillText('Generated by Pick Color Online', 400, 380);

      const link = document.createElement('a');
      link.download = `color-${currentHex.replace('#', '')}.png`;
      link.href = cardCanvas.toDataURL('image/png');
      link.click();
    });
  }

  window.addEventListener('colorpicked', (e: any) => {
    if (e.detail && e.detail.color) {
      updateColorResult(e.detail.color);
    }
  });
</script>