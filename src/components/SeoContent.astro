---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'en' } = Astro.props;
const t = useTranslations(currentLang);
---
<article class="w-full max-w-4xl mx-auto my-12 card rounded-2xl p-6 sm:p-10 shadow-xl leading-relaxed text-text-secondary space-y-8">
  <!-- Article Header -->
  <header class="border-b border-border-subtle pb-6">
    <div class="inline-block bg-accent-purple/10 text-accent-purple font-mono text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
      {t('seoGuideBadge')}
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-text-primary tracking-tight">
      {t('seoGuideTitle')}
    </h2>
    <p class="text-sm text-text-muted mt-2 font-medium">
      {t('seoGuideDesc')}
    </p>
  </header>

  <!-- Section 1: What is a Color Extractor and Color Finder? -->
  <section class="space-y-3">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec1Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec1P1')}
    </p>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec1P2')}
    </p>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec1P3')}
    </p>
  </section>

  <!-- Section 2: Why Use Our Online Photo Color Extractor & Color Finder? -->
  <section class="space-y-3">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec2Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec2P1')}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-4">
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-1">{t('seoSec2Card1Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec2Card1Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-1">{t('seoSec2Card2Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec2Card2Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-1">{t('seoSec2Card3Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec2Card3Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-1">{t('seoSec2Card4Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec2Card4Desc')}</p>
      </div>
    </div>
  </section>

  <!-- Section 3: How It Works - Color Extractor & Color Finder Process -->
  <section class="space-y-4">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec3Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec3P1')}
    </p>

    <ol class="list-decimal list-inside space-y-3 text-sm sm:text-base text-text-secondary font-medium pl-2">
      <li class="flex items-start space-x-3">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-purple text-white text-xs font-bold flex items-center justify-center">1</span>
        <div>
          <strong>{t('seoSec3Step1Title')}</strong> {t('seoSec3Step1Desc')}
        </div>
      </li>
      <li class="flex items-start space-x-3">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-purple text-white text-xs font-bold flex items-center justify-center">2</span>
        <div>
          <strong>{t('seoSec3Step2Title')}</strong> {t('seoSec3Step2Desc')}
        </div>
      </li>
      <li class="flex items-start space-x-3">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-purple text-white text-xs font-bold flex items-center justify-center">3</span>
        <div>
          <strong>{t('seoSec3Step3Title')}</strong> {t('seoSec3Step3Desc')}
        </div>
      </li>
      <li class="flex items-start space-x-3">
        <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-purple text-white text-xs font-bold flex items-center justify-center">4</span>
        <div>
          <strong>{t('seoSec3Step4Title')}</strong> {t('seoSec3Step4Desc')}
        </div>
      </li>
    </ol>
  </section>

  <!-- Section 4: Supported Image Formats -->
  <section class="space-y-3">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec4Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec4P1')}
    </p>

    <div class="space-y-3 mt-2">
      <div class="p-3 bg-surface-secondary rounded-lg border-l-4 border-text-primary text-sm">
        <strong>{t('seoSec4Format1Title')}</strong> {t('seoSec4Format1Desc')}
      </div>
      <div class="p-3 bg-surface-secondary rounded-lg border-l-4 border-text-secondary text-sm">
        <strong>{t('seoSec4Format2Title')}</strong> {t('seoSec4Format2Desc')}
      </div>
      <div class="p-3 bg-surface-secondary rounded-lg border-l-4 border-text-muted text-sm">
        <strong>{t('seoSec4Format3Title')}</strong> {t('seoSec4Format3Desc')}
      </div>
    </div>
  </section>

  <!-- Section 5: Understanding Color Formats -->
  <section class="space-y-3">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec5Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec5P1')}
    </p>

    <div class="overflow-x-auto mt-4">
      <table class="w-full text-left text-xs sm:text-sm border-collapse border border-border rounded-lg overflow-hidden">
        <thead class="bg-surface-secondary text-text-primary font-bold">
          <tr>
            <th class="p-3 border-b border-border">{t('seoSec5ThFormat')}</th>
            <th class="p-3 border-b border-border">{t('seoSec5ThExample')}</th>
            <th class="p-3 border-b border-border">{t('seoSec5ThBestFor')}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border text-text-secondary">
          <tr>
            <td class="p-3 font-mono font-bold">HEX</td>
            <td class="p-3 font-mono">#7928CA</td>
            <td class="p-3">{t('seoSec5HexDesc')}</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold">RGB</td>
            <td class="p-3 font-mono">rgb(121, 40, 202)</td>
            <td class="p-3">{t('seoSec5RgbDesc')}</td>
          </tr>
          <tr>
            <td class="p-3 font-mono font-bold">HSL</td>
            <td class="p-3 font-mono">hsl(270, 67%, 47%)</td>
            <td class="p-3">{t('seoSec5HslDesc')}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Section 6: Use Cases - Who Uses a Color Extractor & Color Finder? -->
  <section class="space-y-3">
    <h3 class="text-xl font-bold text-text-primary flex items-center space-x-2">
      <span class="w-2 h-2 rounded-full bg-text-primary"></span>
      <span>{t('seoSec6Title')}</span>
    </h3>
    <p class="text-sm sm:text-base text-text-secondary">
      {t('seoSec6P1')}
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-4">
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case1Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case1Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case2Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case2Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case3Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case3Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case4Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case4Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case5Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case5Desc')}</p>
      </div>
      <div class="card bg-surface-secondary p-4 rounded-xl border border-border-subtle">
        <h4 class="font-bold text-text-primary text-sm mb-2">{t('seoSec6Case6Title')}</h4>
        <p class="text-xs text-text-secondary">{t('seoSec6Case6Desc')}</p>
      </div>
    </div>
  </section>

  <!-- Section 7: Conclusion -->
  <footer class="pt-4 border-t border-border-subtle text-xs sm:text-sm text-text-muted space-y-2">
    <p>
      {t('seoSec7Summary')}
    </p>
  </footer>
</article>