---
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import logo from '../assets/logo.svg';
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLang;
  title?: string;
  subtitle?: string;
}

const { currentLang = 'en', title, subtitle } = Astro.props;
const t = useTranslations(currentLang);

const displayTitle = title || t('headerTitle');
const displaySubtitle = subtitle || t('headerSubtitle');

const homePath = currentLang === 'en' ? '/' : `/${currentLang}/`;
const faqPath = currentLang === 'en' ? '/faq/' : `/${currentLang}/faq/`;
---

<header class="w-full flex flex-col items-center mb-8 sm:mb-12">
  <!-- Top Navigation Bar -->
  <div class="w-full flex items-center justify-between py-3 px-4 mb-6 bg-surface/85 backdrop-blur-md rounded-2xl border border-border-subtle shadow-md transition-colors">
    <!-- Brand Logo -->
    <a href={homePath} class="flex items-center space-x-3 text-text-primary font-bold text-base sm:text-lg tracking-tight hover:opacity-85 transition-opacity">
      <div class="relative w-8.5 h-8.5 rounded-xl bg-gradient-to-tr from-pink-500 via-purple-600 to-indigo-600 flex items-center justify-center shadow-md ring-2 ring-white/20">
        <img src={logo.src} alt="Color Finder Logo" class="w-4.5 h-4.5 text-white" />
      </div>
      <div class="flex flex-col">
        <span class="leading-tight font-extrabold font-mono text-text-primary">{displayTitle}</span>
        <span class="text-[10px] font-medium text-text-muted">{t('headerTagline')}</span>
      </div>
    </a>

    <!-- Top Controls: FAQ, Dark/Light Theme Toggle Switch, Language Picker -->
    <div class="flex items-center space-x-2 sm:space-x-3">
      <a
        href={faqPath}
        class="text-xs font-semibold text-text-secondary hover:text-text-primary bg-surface-secondary hover:bg-surface-tertiary px-3 py-1.5 rounded-full transition-colors flex items-center space-x-1 border border-border-subtle"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-icon-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>{t('navFaq')}</span>
      </a>

      <!-- Prominent Dark-Light Theme Toggle Pill -->
      <ThemeToggle />

      <!-- Language Picker Dropdown -->
      <LanguagePicker currentLang={currentLang} />
    </div>
  </div>

  <!-- Main Hero Title Section -->
  <div class="text-center max-w-2xl px-2">
    <div class="inline-flex items-center space-x-2 bg-surface-secondary text-text-primary text-[11px] font-mono uppercase tracking-widest px-3 py-1 rounded-full mb-3 shadow-md transition-colors border border-border-subtle">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>{t('heroBadge')}</span>
    </div>

    <!-- Dynamic H1 Title -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-text-primary leading-tight drop-shadow-sm">
      {displayTitle}
    </h1>

    <p class="text-sm sm:text-base text-text-secondary font-medium mt-3 leading-relaxed">
      {displaySubtitle}
    </p>

    <!-- Feature Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs font-semibold text-text-secondary">
      <span class="bg-surface/80 backdrop-blur-sm border border-border-subtle px-3 py-1 rounded-full shadow-2xs">{t('featureFree')}</span>
      <span class="bg-surface/80 backdrop-blur-sm border border-border-subtle px-3 py-1 rounded-full shadow-2xs">{t('featureMagnifier')}</span>
      <span class="bg-surface/80 backdrop-blur-sm border border-border-subtle px-3 py-1 rounded-full shadow-2xs">{t('featurePrivate')}</span>
    </div>
  </div>
</header>