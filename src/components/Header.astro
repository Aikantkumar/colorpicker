---
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.astro';
import type { SupportedLang } from '../i18n/ui';

interface Props {
  currentLang?: SupportedLang;
  title?: string;
  subtitle?: string;
}

const {
  currentLang = 'en',
  title = 'Color Extractor',
  subtitle = 'Extract exact colors instantly from your screen or any image file'
} = Astro.props;

const homePath = currentLang === 'en' ? '/' : `/${currentLang}/`;
const faqPath = currentLang === 'en' ? '/faq/' : `/${currentLang}/faq/`;
---

<header class="w-full flex flex-col items-center mb-8 sm:mb-12">
  <!-- Top Navigation Bar -->
  <div class="w-full flex items-center justify-between py-3 px-4 mb-6 bg-white/85 dark:bg-neutral-900/85 backdrop-blur-md rounded-2xl border border-neutral-200/80 dark:border-neutral-800/80 shadow-md transition-colors">
    <!-- Brand Logo -->
    <a href={homePath} class="flex items-center space-x-3 text-neutral-900 dark:text-white font-bold text-base sm:text-lg tracking-tight hover:opacity-85 transition-opacity">
      <div class="relative w-8.5 h-8.5 rounded-xl bg-gradient-to-tr from-pink-500 via-purple-600 to-indigo-600 flex items-center justify-center shadow-md ring-2 ring-white/20">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4.5 h-4.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="m2 22 1-1h3l9-9" />
          <path d="M3 21v-3l9-9" />
          <path d="m15 6 3-3a2.12 2.12 0 0 1 3 3l-3 3" />
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="leading-tight font-extrabold font-mono text-neutral-900 dark:text-white">{title}</span>
        <span class="text-[10px] font-medium text-neutral-400 dark:text-neutral-500">Online Image & Screen Tool</span>
      </div>
    </a>

    <!-- Top Controls: FAQ, Dark/Light Theme Toggle Switch, Language Picker -->
    <div class="flex items-center space-x-2 sm:space-x-3">
      <a
        href={faqPath}
        class="text-xs font-semibold text-neutral-600 dark:text-neutral-300 hover:text-neutral-900 dark:hover:text-white bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200/80 dark:hover:bg-neutral-700/80 px-3 py-1.5 rounded-full transition-colors flex items-center space-x-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>FAQ</span>
      </a>

      <!-- Prominent Dark-Light Theme Toggle Pill -->
      <ThemeToggle />

      <!-- Language Picker Dropdown -->
      <LanguagePicker currentLang={currentLang} />
    </div>
  </div>

  <!-- Main Hero Title Section -->
  <div class="text-center max-w-2xl px-2">
    <div class="inline-flex items-center space-x-2 bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 text-[11px] font-mono uppercase tracking-widest px-3 py-1 rounded-full mb-3 shadow-md transition-colors">
      <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 dark:bg-emerald-500 animate-pulse"></span>
      <span>Instant Web & Image Color Extraction</span>
    </div>

    <!-- Dynamic H1 Title -->
    <h1 class="text-4xl sm:text-5xl md:text-6xl font-black tracking-tight text-neutral-900 dark:text-white leading-tight drop-shadow-sm">
      {title}
    </h1>

    <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 font-medium mt-3 leading-relaxed">
      {subtitle}
    </p>

    <!-- Feature Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mt-4 text-xs font-semibold text-neutral-600 dark:text-neutral-300">
      <span class="bg-white/80 dark:bg-neutral-800/80 border border-neutral-200/80 dark:border-neutral-700/80 px-3 py-1 rounded-full shadow-2xs backdrop-blur-sm">✨ Free & No Registration</span>
      <span class="bg-white/80 dark:bg-neutral-800/80 border border-neutral-200/80 dark:border-neutral-700/80 px-3 py-1 rounded-full shadow-2xs backdrop-blur-sm">🔍 200px Magnifier Lens</span>
      <span class="bg-white/80 dark:bg-neutral-800/80 border border-neutral-200/80 dark:border-neutral-700/80 px-3 py-1 rounded-full shadow-2xs backdrop-blur-sm">🔒 100% Private (Local Processing)</span>
    </div>
  </div>
</header>
