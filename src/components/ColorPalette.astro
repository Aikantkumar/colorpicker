---
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLang;
}

const { currentLang = 'en' } = Astro.props;
const t = useTranslations(currentLang);
---
<div id="color-palette-section" class="w-full max-w-4xl mx-auto my-8 scroll-mt-24">
  <div class="card rounded-2xl p-6 sm:p-8 shadow-xl relative overflow-hidden">
    
    <!-- Top label / status -->
    <div class="flex items-center justify-between mb-6 pb-4 border-b border-border-subtle">
      <div class="flex items-center space-x-2">
        <span class="w-3 h-3 rounded-full bg-accent-purple inline-block"></span>
        <h3 class="text-lg font-bold text-text-primary tracking-tight">
          {t('paletteTitle')}
        </h3>
      </div>
      <span class="text-xs font-mono text-text-muted uppercase tracking-widest bg-surface-secondary px-3 py-1 rounded-full">
        {t('paletteStatus')}
      </span>
    </div>

    <!-- Color Palette Grid -->
    <div class="space-y-6">
      <div class="flex flex-wrap items-center justify-center gap-2" id="palette-grid" role="list" aria-label={t('paletteAriaLabel')}>
        <!-- Colors will be injected here by JavaScript -->
      </div>

      <!-- Palette Info -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs text-text-muted font-mono" id="palette-info" hidden>
        <span id="palette-count"></span>
        <span id="palette-source"></span>
      </div>
    </div>

    <!-- Control Bar: Color Count & Format Selector -->
    <div class="mt-4 pt-4 border-t border-border-subtle flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center space-x-4 flex-wrap gap-3">
        <!-- Color Count Selector -->
        <div class="flex items-center space-x-2">
          <label for="color-count-select" class="text-xs font-medium text-text-muted uppercase tracking-wider whitespace-nowrap">
            {t('colorCountLabel')}
          </label>
          <div class="relative">
            <select
              id="color-count-select"
              class="bg-surface-secondary border border-border rounded-lg px-10 py-1.5 text-sm font-mono text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-purple focus:border-transparent appearance-none cursor-pointer pr-8"
              aria-label={t('colorCountAria')}
            >
              <option value="5">{t('colorCount5')}</option>
              <option value="8" selected>{t('colorCount8')}</option>
              <option value="10">{t('colorCount10')}</option>
              <option value="15">{t('colorCount15')}</option>
              <option value="20">{t('colorCount20')}</option>
              <option value="30">{t('colorCount30')}</option>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none">
              <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Color Format Selector -->
        <div class="flex items-center space-x-2">
          <label for="color-format-select" class="text-xs font-medium text-text-muted uppercase tracking-wider whitespace-nowrap">
            {t('colorFormatLabel')}
          </label>
          <div class="relative">
            <select
              id="color-format-select"
              class="bg-surface-secondary border border-border rounded-lg px-10 py-1.5 text-sm font-mono text-text-primary focus:outline-none focus:ring-2 focus:ring-accent-purple focus:border-transparent appearance-none cursor-pointer pr-8"
              aria-label={t('colorFormatAria')}
            >
              <option value="hex">{t('formatHex')}</option>
              <option value="rgb">{t('formatRgb')}</option>
              <option value="hsl">{t('formatHsl')}</option>
            </select>
            <div class="absolute inset-y-0 right-0 flex items-center px-2 pointer-events-none">
              <svg class="w-4 h-4 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center space-x-3">
        <button
          type="button"
          id="download-palette-png"
          class="px-4 py-2 btn-primary text-text-on-accent hover:bg-surface-tertiary rounded-xl text-xs font-semibold shadow-md hover:shadow-lg transition-all flex items-center space-x-2 cursor-pointer active:scale-95"
          disabled
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span>{t('downloadPalettePng')}</span>
        </button>

        <button
          type="button"
          id="copy-palette-css"
          class="px-4 py-2 btn-secondary hover:bg-surface-tertiary border border-border rounded-xl text-xs font-semibold shadow-sm flex items-center space-x-2 cursor-pointer active:scale-95 transition-all"
          disabled
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
          <span>{t('copyPaletteCss')}</span>
        </button>
      </div>
    </div>

    <!-- Copy Note -->
    <p class="mt-4 text-xs text-text-muted font-medium text-center" id="palette-copy-note">
      {t('paletteCopyNote')}
    </p>

  </div>
</div>

<script>
  const paletteGrid = document.getElementById('palette-grid');
  const paletteInfo = document.getElementById('palette-info');
  const paletteCount = document.getElementById('palette-count');
  const paletteSource = document.getElementById('palette-source');
  const downloadBtn = document.getElementById('download-palette-png');
  const copyCssBtn = document.getElementById('copy-palette-css');
  const colorCountSelect = document.getElementById('color-count-select');
  const colorFormatSelect = document.getElementById('color-format-select');
  const paletteCopyNote = document.getElementById('palette-copy-note');

  let currentPalette: string[] = [];
  let currentSource = 'default';
  let currentColorCount = 8;
  let currentColorFormat = 'hex';

  // Default palette colors from the mesh (matching createDefaultMesh in MagnifierCanvas.astro)
  const DEFAULT_PALETTE = [
    '#FF007F', '#7928CA', '#007CF0', '#00DFD8', '#FF4D4D', '#F9CB28',
    '#FF0080', '#50E3C2', '#F5A623', '#EE0000', '#EB367F', '#171717', '#FFFFFF'
  ];

  function rgbToHex(r: number, g: number, b: number): string {
    return '#' + ((1 << 24) + (r << 16) + (g << 8) + b).toString(16).slice(1).toUpperCase();
  }

  function hexToRgb(hex: string): { r: number; g: number; b: number } | null {
    const clean = hex.replace('#', '');
    if (clean.length !== 6) return null;
    const num = parseInt(clean, 16);
    return {
      r: (num >> 16) & 255,
      g: (num >> 8) & 255,
      b: num & 255
    };
  }

  function rgbToHsl(r: number, g: number, b: number): { h: number; s: number; l: number } {
    r /= 255; g /= 255; b /= 255;
    const max = Math.max(r, g, b), min = Math.min(r, g, b);
    let h = 0, s = 0, l = (max + min) / 2;

    if (max !== min) {
      const d = max - min;
      s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
      switch (max) {
        case r: h = (g - b) / d + (g < b ? 6 : 0); break;
        case g: h = (b - r) / d + 2; break;
        case b: h = (r - g) / d + 4; break;
      }
      h /= 6;
    }
    return {
      h: Math.round(h * 360),
      s: Math.round(s * 100),
      l: Math.round(l * 100)
    };
  }

  function colorDistance(c1: { r: number; g: number; b: number }, c2: { r: number; g: number; b: number }): number {
    return Math.sqrt(
      Math.pow(c1.r - c2.r, 2) +
      Math.pow(c1.g - c2.g, 2) +
      Math.pow(c1.b - c2.b, 2)
    );
  }

  // Simple median cut color quantization for dominant color extraction
  function extractDominantColors(imageData: ImageData, colorCount: number = 8): string[] {
    const pixels: { r: number; g: number; b: number }[] = [];
    const data = imageData.data;
    
    // Sample pixels (every 4th pixel for performance)
    for (let i = 0; i < data.length; i += 16) {
      const r = data[i];
      const g = data[i + 1];
      const b = data[i + 2];
      const a = data[i + 3];
      if (a > 128) { // Skip transparent pixels
        pixels.push({ r, g, b });
      }
    }

    if (pixels.length === 0) return DEFAULT_PALETTE.slice(0, colorCount);

    // Median cut algorithm
    function medianCut(colors: { r: number; g: number; b: number }[], depth: number): { r: number; g: number; b: number }[] {
      if (depth === 0 || colors.length === 0) {
        // Return average color
        const sum = colors.reduce((acc, c) => ({
          r: acc.r + c.r,
          g: acc.g + c.g,
          b: acc.b + c.b
        }), { r: 0, g: 0, b: 0 });
        return [{
          r: Math.round(sum.r / colors.length),
          g: Math.round(sum.g / colors.length),
          b: Math.round(sum.b / colors.length)
        }];
      }

      // Find channel with largest range
      let minR = 255, maxR = 0, minG = 255, maxG = 0, minB = 255, maxB = 0;
      for (const c of colors) {
        minR = Math.min(minR, c.r); maxR = Math.max(maxR, c.r);
        minG = Math.min(minG, c.g); maxG = Math.max(maxG, c.g);
        minB = Math.min(minB, c.b); maxB = Math.max(maxB, c.b);
      }

      const rangeR = maxR - minR;
      const rangeG = maxG - minG;
      const rangeB = maxB - minB;

      let channel: 'r' | 'g' | 'b' = 'r';
      if (rangeG > rangeR && rangeG > rangeB) channel = 'g';
      else if (rangeB > rangeR && rangeB > rangeG) channel = 'b';

      // Sort by the channel with largest range
      colors.sort((a, b) => a[channel] - b[channel]);

      const mid = Math.floor(colors.length / 2);
      return [
        ...medianCut(colors.slice(0, mid), depth - 1),
        ...medianCut(colors.slice(mid), depth - 1)
      ];
    }

    const depth = Math.ceil(Math.log2(colorCount));
    const dominantColors = medianCut(pixels, depth);
    
    // Convert to hex and deduplicate
    const hexColors = dominantColors.map(c => rgbToHex(c.r, c.g, c.b));
    const uniqueColors = [...new Set(hexColors)];
    
    return uniqueColors.slice(0, colorCount);
  }

  function formatColor(hex: string, format: string): string {
    const rgb = hexToRgb(hex);
    if (!rgb) return hex;
    
    switch (format) {
      case 'rgb':
        return `rgb(${rgb.r}, ${rgb.g}, ${rgb.b})`;
      case 'hsl':
        const hsl = rgbToHsl(rgb.r, rgb.g, rgb.b);
        return `hsl(${hsl.h}, ${hsl.s}%, ${hsl.l}%)`;
      case 'hex':
      default:
        return hex;
    }
  }

  function renderPalette(colors: string[], source: string) {
    if (!paletteGrid) return;
    
    currentPalette = colors;
    currentSource = source;

    paletteGrid.innerHTML = '';
    
    colors.forEach((hex, index) => {
      const rgb = hexToRgb(hex);
      if (!rgb) return;

      const brightness = (rgb.r * 299 + rgb.g * 587 + rgb.b * 114) / 1000;
      const textColor = brightness > 160 ? '#171717' : '#FFFFFF';
      const displayValue = formatColor(hex, currentColorFormat);

      const colorItem = document.createElement('div');
      colorItem.className = 'palette-color-item relative group cursor-pointer';
      colorItem.setAttribute('role', 'listitem');
      colorItem.setAttribute('data-hex', hex);
      colorItem.setAttribute('data-index', index.toString());
      colorItem.style.cssText = `
        width: 140px;
        height: 70px;
        border-radius: 14px;
        background-color: ${hex};
        border: 2px solid var(--border);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
        position: relative;
        overflow: hidden;
      `;

      colorItem.innerHTML = `
        <div class="absolute inset-0 flex flex-col items-center justify-center p-2">
          <span class="font-mono text-[11px] sm:text-[12px] font-bold select-all drop-shadow-sm" style="color: ${textColor}">${displayValue}</span>
          <span class="font-mono text-[9px] font-medium uppercase tracking-wider drop-shadow-sm opacity-80" style="color: ${textColor}">${formatLabel(currentColorFormat)}</span>
        </div>
        <div class="absolute bottom-0 left-0 right-0 h-2 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
      `;

      colorItem.addEventListener('click', () => {
        copyToClipboard(displayValue);
        showCopiedFeedback(colorItem, displayValue);
        
        // Also update the main color swatch
        window.dispatchEvent(new CustomEvent('colorpicked', {
          detail: { color: hex, source: 'palette' }
        }));
      });

      colorItem.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          colorItem.click();
        }
      });

      colorItem.setAttribute('tabindex', '0');
      colorItem.setAttribute('aria-label', `${hex} - RGB(${rgb.r}, ${rgb.g}, ${rgb.b})`);
      
      paletteGrid.appendChild(colorItem);
    });

    // Show palette info
    if (paletteInfo && paletteCount && paletteSource) {
      paletteCount.textContent = `${colors.length} ${colors.length === 1 ? 'color' : 'colors'}`;
      paletteSource.textContent = source === 'default' ? '(Default Mesh)' : `(From ${source})`;
      paletteInfo.hidden = false;
    }

    // Enable buttons
    if (downloadBtn) downloadBtn.disabled = false;
    if (copyCssBtn) copyCssBtn.disabled = false;
    
    // Update copy note based on format
    if (paletteCopyNote) {
      const formatLabels = {
        hex: 'HEX',
        rgb: 'RGB',
        hsl: 'HSL'
      };
      paletteCopyNote.textContent = `Click any color to copy its ${formatLabels[currentColorFormat as keyof typeof formatLabels]} value`;
    }
  }

  function formatLabel(format: string): string {
    return format.toUpperCase();
  }

  function copyToClipboard(text: string) {
    navigator.clipboard.writeText(text).catch(() => {
      // Fallback for older browsers
      const textarea = document.createElement('textarea');
      textarea.value = text;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
    });
  }

  function showCopiedFeedback(element: HTMLElement, text: string) {
    const originalHtml = element.innerHTML;
    const rgb = hexToRgb(text.replace('#', ''));
    const brightness = rgb ? (rgb.r * 299 + rgb.g * 587 + rgb.b * 114) / 1000 : 0;
    const textColor = brightness > 160 ? '#171717' : '#FFFFFF';
    
    // Get theme-aware colors
    const surfaceElevated = getComputedStyle(document.documentElement).getPropertyValue('--surface-elevated').trim() || '#FFFFFF';
    const borderColor = getComputedStyle(document.documentElement).getPropertyValue('--border').trim() || '#E0E2E6';
    const shadowColor = getComputedStyle(document.documentElement).getPropertyValue('--shadow-color-strong').trim() || 'rgba(0,0,0,0.15)';
    
    element.innerHTML = `
      <div class="absolute inset-0 flex flex-col items-center justify-center p-2 copied-feedback backdrop-blur-sm rounded-[12px]" style="background-color: ${surfaceElevated}; border: 1px solid ${borderColor};">
        <span class="font-mono text-[11px] font-bold" style="color: ${textColor}">✓ Copied!</span>
        <span class="font-mono text-[9px] font-medium uppercase tracking-wider" style="color: ${textColor}">${text}</span>
      </div>
    `;
    element.style.transform = 'scale(1.03)';
    element.style.boxShadow = `0 8px 25px ${shadowColor}`;
    element.style.zIndex = '10';

    setTimeout(() => {
      element.innerHTML = originalHtml;
      element.style.transform = '';
      element.style.boxShadow = '';
      element.style.zIndex = '';
    }, 1500);
  }

  function generatePaletteCss(colors: string[]): string {
    let css = ':root {\n';
    colors.forEach((hex, index) => {
      const name = `--color-${index + 1}`;
      css += `  ${name}: ${hex};\n`;
    });
    css += '}\n\n';
    css += '/* Usage example */\n';
    css += '.my-element { background-color: var(--color-1); }\n';
    return css;
  }

  function reExtractAndRender() {
    if (currentSource === 'default') {
      renderPalette(DEFAULT_PALETTE.slice(0, currentColorCount), 'default');
    } else if (currentSource.startsWith('uploaded')) {
      // Re-extract from uploaded image with new count
      // We need to trigger the image extraction again
      window.dispatchEvent(new CustomEvent('reextractpalette', {
        detail: { colorCount: currentColorCount }
      }));
    } else {
      // For any other source, just slice the current palette
      renderPalette(currentPalette.slice(0, currentColorCount), currentSource);
    }
  }

  // Initialize with default palette
  renderPalette(DEFAULT_PALETTE.slice(0, currentColorCount), 'default');

  // Color count selector change
  if (colorCountSelect) {
    colorCountSelect.addEventListener('change', (e) => {
      currentColorCount = parseInt((e.target as HTMLSelectElement).value);
      reExtractAndRender();
    });
  }

  // Color format selector change
  if (colorFormatSelect) {
    colorFormatSelect.addEventListener('change', (e) => {
      currentColorFormat = (e.target as HTMLSelectElement).value;
      // Re-render to update displayed format
      renderPalette(currentPalette, currentSource);
    });
  }

  // Listen for image uploads to extract colors from uploaded image
  window.addEventListener('imageuploaded', async (e: any) => {
    const { url } = e.detail;
    if (!url) return;

    try {
      const img = new Image();
      img.crossOrigin = 'anonymous';
      img.onload = () => {
        // Create canvas to extract image data
        const canvas = document.createElement('canvas');
        const ctx = canvas.getContext('2d', { willReadFrequently: true });
        if (!ctx) return;

        // Resize for performance (max 400px on longest side)
        const maxDim = 400;
        let { width, height } = img;
        if (width > maxDim || height > maxDim) {
          if (width > height) {
            height = Math.round(height * maxDim / width);
            width = maxDim;
          } else {
            width = Math.round(width * maxDim / height);
            height = maxDim;
          }
        }
        canvas.width = width;
        canvas.height = height;
        ctx.drawImage(img, 0, 0, width, height);

        const imageData = ctx.getImageData(0, 0, width, height);
        const colors = extractDominantColors(imageData, currentColorCount);
        renderPalette(colors, 'uploaded image');
      };
      img.src = url;
    } catch (err) {
      console.error('Failed to extract palette from image:', err);
      // Fallback to default
      renderPalette(DEFAULT_PALETTE.slice(0, currentColorCount), 'default (fallback)');
    }
  });

  // Listen for re-extraction request (when color count changes)
  window.addEventListener('reextractpalette', (e: any) => {
    const { colorCount } = e.detail;
    currentColorCount = colorCount;
    
    // Re-extract from the current image if available
    // We need to get the current image from the magnifier canvas
    const magnifierCanvas = document.querySelector('canvas[data-magnifier-canvas]') as HTMLCanvasElement;
    if (magnifierCanvas) {
      const ctx = magnifierCanvas.getContext('2d', { willReadFrequently: true });
      if (ctx) {
        const imageData = ctx.getImageData(0, 0, magnifierCanvas.width, magnifierCanvas.height);
        const colors = extractDominantColors(imageData, colorCount);
        renderPalette(colors, 'uploaded image');
        return;
      }
    }
    // Fallback to default palette
    renderPalette(DEFAULT_PALETTE.slice(0, colorCount), 'default');
  });

  // Also listen for canvas updates (when default mesh is created)
  window.addEventListener('defaultmeshcreated', () => {
    renderPalette(DEFAULT_PALETTE.slice(0, currentColorCount), 'default');
  });

  // Download palette as PNG
  if (downloadBtn) {
    downloadBtn.addEventListener('click', () => {
      if (currentPalette.length === 0) return;

      const cardCanvas = document.createElement('canvas');
      const cols = Math.min(currentPalette.length, 6);
      const rows = Math.ceil(currentPalette.length / cols);
      const swatchWidth = 160;
      const swatchHeight = 90;
      const gap = 16;
      const padding = 40;
      const headerHeight = 100;

      cardCanvas.width = cols * swatchWidth + (cols - 1) * gap + padding * 2;
      cardCanvas.height = rows * swatchHeight + (rows - 1) * gap + padding * 2 + headerHeight;

      const ctx = cardCanvas.getContext('2d');
      if (!ctx) return;

      // Background
      ctx.fillStyle = getComputedStyle(document.documentElement).getPropertyValue('--surface').trim() || '#fafafa';
      ctx.fillRect(0, 0, cardCanvas.width, cardCanvas.height);

      // Title
      const textPrimary = getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim() || '#171717';
      const textSecondary = getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim() || '#666666';
      const textMuted = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim() || '#a1a1a1';

      ctx.fillStyle = textPrimary;
      ctx.font = 'bold 28px sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('Extracted Color Palette', cardCanvas.width / 2, padding + 30);

      ctx.fillStyle = textMuted;
      ctx.font = '14px sans-serif';
      ctx.fillText(`${currentPalette.length} colors • Source: ${currentSource}`, cardCanvas.width / 2, padding + 55);

      ctx.fillStyle = textMuted;
      ctx.font = '12px monospace';
      ctx.fillText(`Format: ${currentColorFormat.toUpperCase()}`, cardCanvas.width / 2, padding + 75);

      // Draw color swatches
      currentPalette.forEach((hex, index) => {
        const col = index % cols;
        const row = Math.floor(index / cols);
        const x = padding + col * (swatchWidth + gap);
        const y = padding + headerHeight + row * (swatchHeight + gap);

        // Swatch background
        ctx.fillStyle = hex;
        ctx.beginPath();
        ctx.roundRect(x, y, swatchWidth, swatchHeight, 16);
        ctx.fill();

        // Border
        ctx.strokeStyle = textMuted;
        ctx.lineWidth = 1;
        ctx.stroke();

        // Value label
        const rgb = hexToRgb(hex);
        if (rgb) {
          const brightness = (rgb.r * 299 + rgb.g * 587 + rgb.b * 114) / 1000;
          ctx.fillStyle = brightness > 160 ? '#171717' : '#FFFFFF';
          ctx.font = 'bold 14px monospace';
          ctx.textAlign = 'center';
          
          const displayValue = formatColor(hex, currentColorFormat);
          ctx.fillText(displayValue, x + swatchWidth / 2, y + swatchHeight / 2 - 6);
          
          ctx.font = '11px monospace';
          ctx.fillText(formatLabel(currentColorFormat), x + swatchWidth / 2, y + swatchHeight / 2 + 14);
        }
      });

      const link = document.createElement('a');
      link.download = `color-palette-${currentSource.replace(/\s+/g, '-')}-${Date.now()}.png`;
      link.href = cardCanvas.toDataURL('image/png');
      link.click();
    });
  }

  // Copy palette as CSS variables
  if (copyCssBtn) {
    copyCssBtn.addEventListener('click', () => {
      if (currentPalette.length === 0) return;
      
      const css = generatePaletteCss(currentPalette);
      copyToClipboard(css);

      // Show feedback
      const span = copyCssBtn.querySelector('span');
      if (span) {
        const origText = span.textContent;
        span.textContent = t('copied') || 'Copied!';
        copyCssBtn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
        setTimeout(() => {
          span.textContent = origText;
          copyCssBtn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
        }, 1500);
      }
    });
  }
</script>

