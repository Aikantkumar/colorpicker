---
---
<div class="relative inline-flex items-center">
  <button
    type="button"
    id="theme-toggle-btn"
    class="relative inline-flex items-center h-8 rounded-full p-1 transition-colors duration-300 cursor-pointer shadow-sm border border-neutral-300/80 dark:border-neutral-700/80 bg-neutral-100 dark:bg-neutral-900 text-neutral-800 dark:text-white hover:border-neutral-400 dark:hover:border-neutral-600 focus:outline-none focus:ring-2 focus:ring-neutral-900 dark:focus:ring-white select-none"
    aria-label="Toggle Light and Dark Mode"
    title="Switch Theme Mode"
  >
    <!-- Light Option -->
    <span class="flex items-center space-x-1 px-2 text-xs font-bold text-neutral-700 dark:text-neutral-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
      <span>Light</span>
    </span>

    <!-- Dark Option -->
    <span class="flex items-center space-x-1 px-2 text-xs font-bold text-neutral-400 dark:text-emerald-400 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
      <span>Dark</span>
    </span>

    <!-- Active Sliding Pill Indicator -->
    <span
      id="theme-toggle-knob"
      class="absolute top-1 left-1 bottom-1 w-[calc(50%-4px)] bg-white dark:bg-neutral-800 rounded-full shadow-md transition-transform duration-300 ease-in-out pointer-events-none transform translate-x-0 dark:translate-x-[calc(100%+4px)] border border-neutral-200 dark:border-neutral-700"
    ></span>
  </button>
</div>

<script>
  const toggleBtn = document.getElementById('theme-toggle-btn');
  const toggleKnob = document.getElementById('theme-toggle-knob');

  function updateKnobPosition() {
    const isDark = document.documentElement.classList.contains('dark');
    if (toggleKnob) {
      if (isDark) {
        toggleKnob.style.transform = 'translateX(calc(100% + 4px))';
      } else {
        toggleKnob.style.transform = 'translateX(0)';
      }
    }
  }

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
      updateKnobPosition();
    });

    // Initialize knob position
    updateKnobPosition();
  }
</script>
