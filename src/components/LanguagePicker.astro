---
import { LANGUAGES, type SupportedLang } from '../i18n/ui';
import { getLanguagePath } from '../i18n/utils';

interface Props {
  currentLang: SupportedLang;
}

const { currentLang } = Astro.props;
const current = LANGUAGES[currentLang] || LANGUAGES.en;
---

<div class="relative inline-block text-left" id="language-picker-container">
  <button
    type="button"
    id="lang-menu-btn"
    class="inline-flex items-center space-x-2 bg-white/90 hover:bg-neutral-100 border border-neutral-200/90 text-neutral-800 text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-neutral-900"
    aria-expanded="false"
    aria-haspopup="true"
  >
    <span class="text-sm">{current.flag}</span>
    <span>{current.name}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Dropdown Menu -->
  <div
    id="lang-menu-dropdown"
    class="hidden absolute right-0 mt-2 w-40 rounded-xl bg-white border border-neutral-200/90 shadow-xl ring-1 ring-black/5 z-50 overflow-hidden py-1"
  >
    {(Object.entries(LANGUAGES) as [SupportedLang, typeof LANGUAGES[SupportedLang]][]).map(([code, info]) => {
      const isSelected = code === currentLang;
      const path = getLanguagePath(code);
      return (
        <a
          href={path}
          class={`flex items-center justify-between px-3.5 py-2 text-xs font-medium transition-colors ${
            isSelected
              ? 'bg-neutral-900 text-white font-semibold'
              : 'text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900'
          }`}
        >
          <span class="flex items-center space-x-2">
            <span>{info.flag}</span>
            <span>{info.name}</span>
          </span>
          {isSelected && (
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  const btn = document.getElementById('lang-menu-btn');
  const dropdown = document.getElementById('lang-menu-dropdown');

  if (btn && dropdown) {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', () => {
      if (!dropdown.classList.contains('hidden')) {
        dropdown.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
