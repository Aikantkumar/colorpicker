---
import { getFaqItems } from '../data/faqData';
import type { SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  currentLang?: SupportedLang;
  title?: string;
  subtitle?: string;
}

const { currentLang = 'en', title, subtitle } = Astro.props;
const t = useTranslations(currentLang);
const faqItems = getFaqItems(currentLang);

const displayTitle = title || t('faqTitle');
const displaySubtitle = subtitle || t('faqSubtitle');
---

<section class="w-full max-w-4xl mx-auto my-8 card rounded-2xl p-6 sm:p-10 shadow-xl">
  <!-- FAQ Header -->
  <div class="text-center max-w-2xl mx-auto mb-8">
    <div class="inline-block bg-surface-secondary text-text-primary font-mono text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider mb-2">
      {t('faqBadge')}
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-text-primary tracking-tight">
      {displayTitle}
    </h2>
    <p class="text-sm text-text-muted mt-2 font-medium">
      {displaySubtitle}
    </p>
  </div>

  <!-- Search Filter Input -->
  <div class="relative max-w-md mx-auto mb-8">
    <input
      type="text"
      id="faq-search-input"
      placeholder={t('faqSearchPlaceholder')}
      class="w-full pl-10 pr-4 py-2.5 input rounded-xl text-text-primary placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-input-focus focus:bg-surface transition-all border border-border"
    />
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-icon-muted absolute left-3.5 top-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>

  <!-- FAQ Accordion List -->
  <div class="space-y-3" id="faq-list">
    {faqItems.map((item, index) => (
      <details
        class="faq-item group card bg-surface-secondary hover:bg-surface-tertiary/80 border border-border-subtle rounded-xl transition-all overflow-hidden"
        data-question={item.question.toLowerCase()}
        data-answer={item.answer.toLowerCase()}
      >
        <summary class="flex items-center justify-between p-4 sm:p-5 font-bold text-text-primary text-base sm:text-lg cursor-pointer select-none">
          <span class="flex items-center space-x-3 pr-4">
            <span class="text-xs font-mono text-icon-muted font-normal">#{String(index + 1).padStart(2, '0')}</span>
            <span>{item.question}</span>
          </span>
          <span class="w-6 h-6 rounded-full bg-surface border border-border flex items-center justify-center text-icon-muted group-open:rotate-180 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 text-sm sm:text-base text-text-secondary leading-relaxed border-t border-border-subtle/40 pt-3">
          {item.answer}
        </div>
      </details>
    ))}
  </div>

  <div id="no-faq-results" class="hidden text-center py-8 text-text-muted text-sm">
    {t('faqNoResults')}
  </div>
</section>

<script>
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const faqItems = document.querySelectorAll('.faq-item');
  const noResults = document.getElementById('no-faq-results');

  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
      let visibleCount = 0;

      faqItems.forEach(item => {
        const q = item.getAttribute('data-question') || '';
        const a = item.getAttribute('data-answer') || '';

        if (q.includes(query) || a.includes(query)) {
          (item as HTMLElement).style.display = 'block';
          visibleCount++;
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      }
    });
  }
</script>