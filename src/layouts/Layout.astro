---
import '../assets/globals.css';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  lang?: SupportedLang;
  canonicalUrl?: string;
}

const { title, description, lang = 'en', canonicalUrl } = Astro.props;

// Generate hreflang links for SEO
const hreflangLinks = getHreflangLinks('https://findandextractcolors.com');

// Current canonical URL - use provided or derive from current page
const finalCanonicalUrl = canonicalUrl || `https://findandextractcolors.com${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-TC5PSQECVS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-TC5PSQECVS');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Find and Extract Colors" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Inline Script to prevent FOUC (Flash of wrong theme) -->
    <script is:inline>
      (function() {
        const storedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const isDark = storedTheme === 'dark' || (!storedTheme && prefersDark);
        if (isDark) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        document.documentElement.style.visibility = 'visible';
      })();
    </script>
    <style is:inline>
      html { visibility: hidden; }
      html.dark { color-scheme: dark; }
      html:not(.dark) { color-scheme: light; }
    </style>

    <!-- HREFLANG Meta Markup for Multi-language Search Engine Ranking -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Open Graph & Social SEO -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={finalCanonicalUrl} />
    <meta property="og:locale" content={lang} />
    <meta property="og:site_name" content="Find and Extract Colors" />

    <!-- Twitter/X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={finalCanonicalUrl} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- WebApplication JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Find and Extract Colors",
      "url": finalCanonicalUrl,
      "description": description,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "inLanguage": ["en", "es", "ja", "fr", "de", "pt", "ko", "it"]
    })} />

    <!-- Page-specific JSON-LD schemas (e.g., FAQPage) -->
    <slot name="head" />
  </head>
  <body class="font-sans antialiased min-h-screen relative">
    
    <!-- LIGHT MODE: Moving 7-Color Palette Grid Background -->
    <div class="bg-light-color-palette"></div>

    <!-- DARK MODE: Black Background + Multiple Moving Green Aurora Borealis Strips -->
    <div class="bg-dark-aurora-container">
      <div class="aurora-strip aurora-strip-1"></div>
      <div class="aurora-strip aurora-strip-2"></div>
      <div class="aurora-strip aurora-strip-3"></div>
      <div class="aurora-strip aurora-strip-4"></div>
    </div>

    <!-- Main Content Container -->
    <slot />
  </body>
</html>