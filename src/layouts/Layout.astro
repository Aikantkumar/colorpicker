---
import '../assets/globals.css';
import { getHreflangLinks } from '../i18n/utils';
import type { SupportedLang } from '../i18n/ui';

export interface Props {
  title: string;
  description: string;
  lang?: SupportedLang;
}

const { title, description, lang = 'en' } = Astro.props;

// Generate hreflang links for SEO
const hreflangLinks = getHreflangLinks('https://pickcolor.online');

// Current canonical URL
const canonicalPath = lang === 'en' ? '/' : `/${lang}/`;
const canonicalUrl = `https://pickcolor.online${canonicalPath}`;
---
<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- HREFLANG Meta Markup for Multi-language Search Engine Ranking -->
    {hreflangLinks.map((link) => (
      <link rel="alternate" hreflang={link.lang} href={link.href} />
    ))}

    <!-- Open Graph & Social SEO -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <!-- WebApplication JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Pick Color Online",
      "url": canonicalUrl,
      "description": description,
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "All",
      "inLanguage": ["en", "es", "ja", "fr", "de", "pt", "ko", "it"]
    })} />
  </head>
  <body class="bg-[#fafafa] text-[#171717] font-sans antialiased min-h-screen selection:bg-neutral-900 selection:text-white">
    <slot />
  </body>
</html>
