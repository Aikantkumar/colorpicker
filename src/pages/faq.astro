---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import { getFaqItems } from '../data/faqData';
import { useTranslations } from '../i18n/utils';

const t = useTranslations('en');

const pageTitle = `${t('headerTitle')} FAQ | ${t('siteTitle')}`;
const pageDescription = `${t('siteDescription')} FAQ`;

// Generate FAQPage JSON-LD Schema
const faqItems = getFaqItems('en');
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map((item) => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<Layout title={pageTitle} description={pageDescription} lang="en">
  <!-- Inject JSON-LD Schema for Google FAQ Rich Snippets -->
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 flex flex-col items-center">
    <!-- Header -->
    <Header
      currentLang="en"
      title={`${t('headerTitle')} FAQ`}
      subtitle={t('headerSubtitle')}
    />

    <!-- FAQ Accordion Section -->
    <FaqSection currentLang="en" />

    <!-- Back to Main Tool CTA -->
    <div class="mt-8 text-center">
      <a
        href="/"
        class="inline-flex items-center space-x-2 bg-neutral-900 text-white hover:bg-neutral-800 px-6 py-3 rounded-xl text-sm font-semibold shadow-md hover:shadow-lg transition-all"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        <span>{t('backToTool')}</span>
      </a>
    </div>

    <!-- Footer -->
    <Footer currentLang="en" />
  </main>
</Layout>
