---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import DropperButton from '../components/DropperButton.astro';
import ImageUploader from '../components/ImageUploader.astro';
import MagnifierCanvas from '../components/MagnifierCanvas.astro';
import ColorSwatch from '../components/ColorSwatch.astro';
import SeoContent from '../components/SeoContent.astro';
import Footer from '../components/Footer.astro';
import { LANGUAGES, DEFAULT_LANG, type SupportedLang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

export function getStaticPaths() {
  const paths = Object.keys(LANGUAGES).map((code) => {
    if (code === DEFAULT_LANG) {
      return { params: { lang: undefined } }; // matches root '/'
    }
    return { params: { lang: code } }; // matches '/es/', '/ja/', etc.
  });
  return paths;
}

const { lang: langParam } = Astro.params;
const lang = (langParam as SupportedLang) || DEFAULT_LANG;
const t = useTranslations(lang);

// Targeted SEO Title & Meta Description for BOTH Color Extractor & Color Finder
const seoTitle = t('homeSeoTitle');
const seoDescription = t('homeSeoDescription');

const faqLinkPath = lang === DEFAULT_LANG ? '/faq/' : `/${lang}/faq/`;
---

<Layout title={seoTitle} description={seoDescription} lang={lang}>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 flex flex-col items-center relative">
    
    <!-- Premium Header Component -->
    <Header
      currentLang={lang}
      title={t('headerTitle')}
      subtitle={t('headerSubtitle')}
    />

    <!-- Top Impression Section: 2 Main Features Side-by-Side with Vertical Divider -->
    <section class="w-full card rounded-2xl shadow-xl p-6 sm:p-8 mb-10">
      <div class="flex flex-col md:flex-row items-stretch justify-between gap-6 md:gap-0">
        
        <!-- Left Feature: Dropper Lens -->
        <div class="flex-1 flex flex-col items-center justify-between px-2 sm:px-6 text-center">
          <h2 class="text-lg sm:text-xl font-bold text-text-primary tracking-tight mb-3">
            {t('dropperHeading')}
          </h2>
          <DropperButton currentLang={lang} />
        </div>

        <!-- Vertical Divider (Desktop) / Horizontal Divider (Mobile) -->
        <div class="hidden md:block w-px bg-border self-stretch my-2"></div>
        <div class="block md:hidden h-px w-full bg-border my-2"></div>

        <!-- Right Feature: Upload Image -->
        <div class="flex-1 flex flex-col items-center justify-between px-2 sm:px-6 text-center">
          <h2 class="text-lg sm:text-xl font-bold text-text-primary tracking-tight mb-3">
            {t('uploadHeading')}
          </h2>
          <ImageUploader currentLang={lang} />
        </div>

      </div>
    </section>

    <!-- Results Swatch Section (Right below features on first impression) -->
    <section class="w-full">
      <ColorSwatch currentLang={lang} />
    </section>

    <!-- Mesh & 200px Zoom Lens Canvas Section -->
    <section class="w-full mt-4">
      <MagnifierCanvas currentLang={lang} />
    </section>

    <!-- 800 - 1200 Words SEO Guide Content (After main components) -->
    <SeoContent currentLang={lang} />

    <!-- FAQ Teaser Link Section -->
    <section class="w-full max-w-4xl bg-surface-tertiary text-text-primary rounded-2xl p-6 sm:p-8 text-center my-6 shadow-xl flex flex-col items-center border border-border">
      <h3 class="text-2xl font-extrabold text-text-primary">{t('faqTeaserTitle')}</h3>
      <p class="text-xs sm:text-sm text-text-muted mt-2 max-w-xl">
        {t('faqTeaserSubtitle')}
      </p>
      <a
        href={faqLinkPath}
        class="mt-4 inline-flex items-center space-x-2 btn-primary text-text-on-accent hover:bg-surface-tertiary px-6 py-2.5 rounded-xl text-xs font-bold transition-all shadow-md"
      >
        <span>{t('faqTeaserBtn')}</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </section>

    <!-- Footer with Links to Contact, Privacy, Terms, FAQ, Languages -->
    <Footer currentLang={lang} />
  </main>
</Layout>