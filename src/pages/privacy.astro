---
import { DEFAULT_LANG } from '../i18n/ui';
import { getLanguagePath } from '../i18n/utils';

const lang = DEFAULT_LANG;
const redirectPath = getLanguagePath(lang) + 'privacy/';
---

<script is:inline>
  window.location.href = "/en/privacy/";
</script>

<meta http-equiv="refresh" content="0; url=/en/privacy/" />